<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Valentine Card 💌</title>

  <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: "Poppins", sans-serif;
      overflow-x: hidden;
      color: white;
      text-align: center;
      min-height: 100vh;
      background: linear-gradient(to bottom, #4facfe, #dfe9f3);
      transition: 0.6s;
      position: relative;
    }

    body.night {
      background: linear-gradient(to bottom, #050b2a, #240a3a);
      color: #fff;
    }

    .clouds {
      position: fixed;
      top: 0;
      left: 0;
      width: 200%;
      height: 100%;
      background: url("https://i.ibb.co/8bP8N9y/clouds.png") repeat-x;
      opacity: 0.35;
      animation: moveClouds 60s linear infinite;
      z-index: 0;
      transition: 0.6s;
    }

    body.night .clouds { opacity: 0.15; }

    @keyframes moveClouds {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    .sparkle {
      position: fixed;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: rgba(255,255,255,0.9);
      box-shadow: 0 0 10px rgba(255,255,255,0.9);
      animation: sparkleAnim 3s linear infinite;
      z-index: 3;
    }

    @keyframes sparkleAnim {
      from { transform: translateY(0) scale(1); opacity: 1; }
      to { transform: translateY(120vh) scale(0.2); opacity: 0; }
    }

    .heart {
      position: fixed;
      top: -20px;
      animation: fall linear infinite;
      opacity: 0.95;
      z-index: 5;
      filter: drop-shadow(0 5px 8px rgba(0,0,0,0.25));
    }

    @keyframes fall {
      from { transform: translateY(-10px) rotate(0deg); }
      to { transform: translateY(110vh) rotate(360deg); }
    }

    .petal {
      position: fixed;
      top: -30px;
      font-size: 22px;
      animation: petalFall linear infinite;
      opacity: 0.85;
      z-index: 4;
    }

    @keyframes petalFall {
      from { transform: translateY(-10px) rotate(0deg); }
      to { transform: translateY(120vh) rotate(720deg); }
    }

    .container {
      width: 95%;
      max-width: 1000px;
      margin: auto;
      padding: 20px;
      position: relative;
      z-index: 10;
    }

    h1 {
      font-family: "Great Vibes", cursive;
      font-size: 3.4rem;
      margin-top: 15px;
      text-shadow: 0 4px 15px rgba(0,0,0,0.35);
    }

    h2 {
      margin-top: 25px;
      font-size: 1.5rem;
      text-shadow: 0 2px 12px rgba(0,0,0,0.3);
    }

    .card-box {
      background: rgba(255,255,255,0.15);
      border: 2px solid rgba(255,255,255,0.35);
      border-radius: 18px;
      padding: 18px;
      margin-top: 18px;
      box-shadow: 0 15px 30px rgba(0,0,0,0.25);
      backdrop-filter: blur(7px);
      transition: 0.6s;
    }

    body.night .card-box {
      background: rgba(0,0,0,0.25);
      border: 2px solid rgba(255,255,255,0.25);
    }

    textarea, input, select {
      width: 90%;
      max-width: 600px;
      padding: 12px;
      border-radius: 14px;
      border: none;
      outline: none;
      font-size: 16px;
      margin-top: 10px;
      font-family: "Poppins", sans-serif;
    }

    button {
      padding: 12px 18px;
      margin-top: 15px;
      border: none;
      border-radius: 14px;
      cursor: pointer;
      font-size: 16px;
      font-weight: 600;
      color: white;
      background: linear-gradient(135deg, #ff5f9e, #ff2e63);
      box-shadow: 0 8px 18px rgba(0,0,0,0.3);
      transition: 0.3s;
    }

    button:hover {
      transform: scale(1.05);
      box-shadow: 0 12px 22px rgba(0,0,0,0.4);
    }

    .btn-secondary {
      background: linear-gradient(135deg, #2b5876, #4e4376);
    }

    .countdown {
      font-size: 1.2rem;
      font-weight: 600;
      margin-top: 10px;
      text-shadow: 0 2px 12px rgba(0,0,0,0.35);
    }

    .row-buttons {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
      margin-top: 12px;
    }

    /* Envelope */
    .envelope-container {
      width: 360px;
      height: 240px;
      margin: 25px auto;
      perspective: 1200px;
      cursor: pointer;
      position: relative;
    }

    .envelope {
      width: 100%;
      height: 100%;
      position: relative;
      border-radius: 18px;
      background: rgba(255,255,255,0.18);
      border: 2px solid rgba(255,255,255,0.4);
      box-shadow: 0 15px 25px rgba(0,0,0,0.35);
      overflow: hidden;
      transition: 0.6s;
    }

    .flap {
      position: absolute;
      width: 100%;
      height: 60%;
      background: rgba(255,255,255,0.25);
      clip-path: polygon(0 0, 100% 0, 50% 100%);
      transform-origin: top;
      transition: 1s;
    }

    .letter {
      position: absolute;
      bottom: -100%;
      left: 50%;
      transform: translateX(-50%);
      width: 92%;
      height: 155px;
      background: rgba(255,255,255,0.95);
      border-radius: 14px;
      padding: 12px;
      font-family: "Great Vibes", cursive;
      font-size: 28px;
      color: #222;
      overflow-y: auto;
      transition: 1s;
      box-shadow: 0 8px 18px rgba(0,0,0,0.25);
    }

    .opened .flap { transform: rotateX(180deg); }
    .opened .letter { bottom: 12px; }

    /* Wax Seal */
    .wax-seal {
      position: absolute;
      bottom: 10px;
      left: 50%;
      transform: translateX(-50%);
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255,0,80,0.9), rgba(180,0,60,1));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.2rem;
      box-shadow: 0 12px 20px rgba(0,0,0,0.4);
      border: 3px solid rgba(255,255,255,0.5);
      z-index: 50;
      transition: 0.4s;
    }

    .wax-seal.unlocked {
      opacity: 0.25;
      transform: translateX(-50%) scale(0.8);
    }

    .seal-preview {
      font-size: 2.5rem;
      margin-top: 12px;
      filter: drop-shadow(0 6px 10px rgba(0,0,0,0.35));
    }

    /* Gallery */
    .gallery {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
      margin-top: 15px;
    }

    .gallery img {
      width: 160px;
      height: 160px;
      object-fit: cover;
      border-radius: 18px;
      border: 3px solid rgba(255,255,255,0.6);
      box-shadow: 0 10px 20px rgba(0,0,0,0.35);
      transition: 0.3s;
    }

    .gallery img:hover { transform: scale(1.08); }

    .border-rose { border: 4px solid rgba(255, 105, 180, 0.8); }
    .border-lily { border: 4px solid rgba(255, 255, 200, 0.8); }
    .border-tulip { border: 4px solid rgba(200, 100, 255, 0.8); }

    /* Poem Box */
    .poem-box {
      margin-top: 15px;
      padding: 15px;
      border-radius: 18px;
      background: rgba(255,255,255,0.18);
      font-family: "Great Vibes", cursive;
      font-size: 30px;
      white-space: pre-line;
      box-shadow: 0 10px 22px rgba(0,0,0,0.25);
    }

    #map {
      width: 100%;
      height: 320px;
      margin-top: 15px;
      border-radius: 18px;
      border: 3px solid rgba(255,255,255,0.5);
      box-shadow: 0 15px 25px rgba(0,0,0,0.3);
    }

    footer {
      margin-top: 40px;
      opacity: 0.85;
      font-size: 14px;
    }
  </style>
</head>

<body>
  <div class="clouds"></div>

  <div class="container">
    <h1>Happy Valentine's Day 💙</h1>
    <div class="countdown" id="countdown"></div>

    <div class="card-box">
      <h2>🎛️ Controls</h2>
      <div class="row-buttons">
        <button class="btn-secondary" onclick="toggleNightMode()">🌙 Night Mode</button>
        <button onclick="shareWhatsApp()">📲 Share to WhatsApp</button>
      </div>
    </div>

    <div class="card-box">
      <h2>🎵 Romantic Music</h2>
      <button id="musicBtn" onclick="toggleMusic()">🎵 Play Music</button>

      <!-- SAFE MUSIC FOR HOSTING (copyright-free) -->
      <audio id="music" loop>
        <source src="https://cdn.pixabay.com/download/audio/2022/03/15/audio_2d5e3c5a8d.mp3?filename=soft-piano-ambient-11157.mp3" type="audio/mp3">
      </audio>
    </div>

    <div class="card-box">
      <h2>✍️ Write Your Love Message</h2>
      <textarea id="messageInput" placeholder="Type your message here..."></textarea>
      <br>
      <button onclick="updateMessage()">💖 Put in Envelope</button>
    </div>

    <div class="card-box">
      <h2>🔒 Choose Wax Seal</h2>
      <select id="sealSelect" onchange="updateSeal()">
        <option value="">-- Choose Seal --</option>
        <option value="❤️">Classic Heart ❤️</option>
        <option value="💘">Cupid Arrow 💘</option>
        <option value="🌹">Rose Seal 🌹</option>
        <option value="✨">Sparkle Seal ✨</option>
        <option value="💍">Ring Seal 💍</option>
        <option value="🦋">Butterfly Seal 🦋</option>
      </select>

      <div class="seal-preview" id="sealPreview">❔</div>
      <p id="sealHint">Choose a wax seal first to unlock the envelope 🔒</p>
    </div>

    <div class="card-box">
      <h2>✉️ Envelope</h2>
      <p>Tap the envelope to open (only if unlocked)</p>

      <div class="envelope-container" onclick="toggleEnvelope()">
        <div class="envelope" id="envelope">
          <div class="flap"></div>
          <div class="letter" id="letter">Your message will appear here...</div>
        </div>

        <div class="wax-seal" id="waxSeal">🔒</div>
      </div>

      <button class="btn-secondary" onclick="closeEnvelope()">📩 Close Envelope</button>
    </div>

    <div class="card-box">
      <h2>🌙 Secret Romantic Poem</h2>
      <button onclick="generatePoem()">🌹 Generate Poem</button>
      <div class="poem-box" id="poemBox">Click the button to reveal a secret poem...</div>
    </div>

    <div class="card-box" id="galleryBox">
      <h2>📸 Upload Cherished Photos</h2>
      <input type="file" accept="image/*" multiple onchange="uploadPhotos(event)" />

      <h2>🌸 Choose Floral Border</h2>
      <select onchange="changeBorder(this.value)">
        <option value="">Default Border</option>
        <option value="border-rose">Rose Border 🌹</option>
        <option value="border-lily">Lily Border 🌼</option>
        <option value="border-tulip">Tulip Border 🌷</option>
      </select>

      <div class="gallery" id="gallery"></div>
    </div>

    <div class="card-box">
      <h2>🗺️ Memory Map</h2>
      <p>Click the map to pin your favorite places together 💞</p>
      <div id="map"></div>
    </div>

    <footer>made with love 💙</footer>
  </div>

  <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

  <script>
    /* Falling Hearts */
    function createHeart() {
      const heart = document.createElement("div");
      heart.className = "heart";
      heart.innerHTML = ["💖","💘","❤️","💕","💞"][Math.floor(Math.random()*5)];
      heart.style.left = Math.random() * 100 + "vw";
      heart.style.animationDuration = (3 + Math.random() * 5) + "s";
      heart.style.fontSize = (18 + Math.random() * 22) + "px";
      document.body.appendChild(heart);
      setTimeout(() => heart.remove(), 9000);
    }
    setInterval(createHeart, 260);

    /* Sparkles */
    function createSparkle() {
      const s = document.createElement("div");
      s.className = "sparkle";
      s.style.left = Math.random() * 100 + "vw";
      s.style.animationDuration = (2 + Math.random() * 3) + "s";
      s.style.opacity = Math.random();
      document.body.appendChild(s);
      setTimeout(() => s.remove(), 5000);
    }
    setInterval(createSparkle, 350);

    /* Falling Petals */
    function createPetal() {
      const p = document.createElement("div");
      p.className = "petal";
      p.innerHTML = ["🌹","🌸","🌺"][Math.floor(Math.random()*3)];
      p.style.left = Math.random() * 100 + "vw";
      p.style.animationDuration = (4 + Math.random() * 6) + "s";
      p.style.fontSize = (18 + Math.random() * 18) + "px";
      document.body.appendChild(p);
      setTimeout(() => p.remove(), 12000);
    }
    setInterval(createPetal, 600);

    /* Countdown */
    function updateCountdown() {
      const now = new Date();
      let year = now.getFullYear();
      let valentines = new Date(year, 1, 14);

      if (now > valentines) valentines = new Date(year + 1, 1, 14);

      const diff = valentines - now;

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
      const minutes = Math.floor((diff / (1000 * 60)) % 60);
      const seconds = Math.floor((diff / 1000) % 60);

      document.getElementById("countdown").innerHTML =
        `⏳ Countdown to Valentine's Day: ${days}d ${hours}h ${minutes}m ${seconds}s`;
    }
    setInterval(updateCountdown, 1000);
    updateCountdown();

    /* Night Mode */
    function toggleNightMode() {
      document.body.classList.toggle("night");
    }

    /* Music */
    function toggleMusic() {
      const music = document.getElementById("music");
      const btn = document.getElementById("musicBtn");

      if (music.paused) {
        music.play();
        btn.innerHTML = "⏸ Pause Music";
      } else {
        music.pause();
        btn.innerHTML = "🎵 Play Music";
      }
    }

    /* Message */
    function updateMessage() {
      const msg = document.getElementById("messageInput").value;
      document.getElementById("letter").innerHTML = msg || "Your message will appear here...";
    }

    /* Wax Seal Unlock */
    let unlocked = false;

    function updateSeal() {
      const seal = document.getElementById("sealSelect").value;
      const preview = document.getElementById("sealPreview");
      const waxSeal = document.getElementById("waxSeal");
      const hint = document.getElementById("sealHint");

      if (seal === "") {
        preview.innerHTML = "❔";
        waxSeal.innerHTML = "🔒";
        unlocked = false;
        hint.innerHTML = "Choose a wax seal first to unlock the envelope 🔒";
        waxSeal.classList.remove("unlocked");
      } else {
        preview.innerHTML = seal;
        waxSeal.innerHTML = seal;
        unlocked = true;
        hint.innerHTML = "Envelope unlocked! Tap the envelope ✨";
        waxSeal.classList.add("unlocked");
      }
    }

    /* Envelope Toggle */
    function toggleEnvelope() {
      if (!unlocked) {
        alert("🔒 The envelope is locked! Choose a wax seal first.");
        return;
      }
      document.getElementById("envelope").classList.toggle("opened");
    }

    function closeEnvelope() {
      document.getElementById("envelope").classList.remove("opened");
    }

    /* Gallery */
    function uploadPhotos(event) {
      const files = event.target.files;
      const gallery = document.getElementById("gallery");

      for (let file of files) {
        const reader = new FileReader();
        reader.onload = function(e) {
          const img = document.createElement("img");
          img.src = e.target.result;
          gallery.appendChild(img);
        };
        reader.readAsDataURL(file);
      }
    }

    function changeBorder(borderClass) {
      const box = document.getElementById("galleryBox");
      box.className = "card-box " + borderClass;
    }

    /* Poem Generator */
    function generatePoem() {
      const poems = [
        "In the blue sky, I see your smile,\nIt makes my heart stay for a while.\nForever yours, forever true,\nMy world is brighter just with you.",
        "If love was written in the stars,\nYour name would shine from near to far.\nEvery breath I take, I feel,\nThis love for you is truly real.",
        "My heart is an envelope sealed with care,\nAnd inside is love beyond compare.\nNo matter time, no matter space,\nI’ll always long for your embrace.",
        "You are my sunrise, soft and sweet,\nMy favorite dream I want to keep.\nHold my hand, don’t let it go,\nTogether our love will always glow.",
        "Even the ocean can’t measure,\nHow much you are my greatest treasure.\nOne heart, one soul, one destiny,\nForever you belong with me."
      ];

      const randomPoem = poems[Math.floor(Math.random() * poems.length)];
      document.getElementById("poemBox").innerText = randomPoem;
    }

    /* WhatsApp Share */
    function shareWhatsApp() {
      const msg = document.getElementById("messageInput").value || "I made a Valentine card for you 💌💙";
      const url = window.location.href;
      const shareText = encodeURIComponent(msg + "\n\nOpen my Valentine card here:\n" + url);
      window.open("https://wa.me/?text=" + shareText, "_blank");
    }

    /* Map */
    function initMap() {
      const map = L.map('map').setView([0, 0], 2);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 18
      }).addTo(map);

      map.on('click', function(e) {
        L.marker([e.latlng.lat, e.latlng.lng]).addTo(map)
          .bindPopup("💞 Our Memory Spot 💞")
          .openPopup();
      });
    }

    window.onload = initMap;
  </script>

</body>
</html>